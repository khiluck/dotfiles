+/* Ширину центрированного окна считаем по самым длинным строкам, а не по всем.
+ * TEXTW() для каждой строки стоит дорого на больших списках: для глифа, которого
+ * нет в основном шрифте (например emoji), каждый раз ищется резервный шрифт —
+ * 1631 строка emoji давала ~500 мс задержки перед показом меню. */
 static int
 max_textw(void)
 {
+	unsigned int maxlen = 0, measured = 0;
 	int len = 0;
-	for (struct item *item = items; item && item->text; item++)
-		len = MAX(item->width, len);
+	struct item *item;
+
+	for (item = items; item && item->text; item++)
+		maxlen = MAX(item->len, maxlen);
+	for (item = items; item && item->text && measured < measure_max; item++)
+		if (item->len + measure_slack >= maxlen) {
+			len = MAX(TEXTW(item->text), len);
+			measured++;
+		}
 	return len;
 }
 
