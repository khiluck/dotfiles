#!/bin/bash

set -euo pipefail

FILENAME="$HOME/Videos/screencast-$(date '+%y%m%d-%H%M-%S').mp4"

# --- Баланс и обработка звука (крути под себя) ---------------------------------
# Системный звук и микрофон пишутся ДВУМЯ отдельными входами и микшируются в
# ffmpeg, поэтому уровни независимы, а шумодав вешается ТОЛЬКО на микрофон и не
# трогает музыку/звук из видео.
SYS_VOL=0.28          # громкость системного звука в миксе: тише, чтобы говорить поверх (1.0 = как есть)
MIC_VOL=1.4           # усиление микрофона в миксе
MIC_HIGHPASS=80       # срезать низкий гул/вибрацию ниже этой частоты, Гц
MIC_DENOISE="afftdn=nr=12:nf=-25:tn=1"   # шумодав микрофона (nr — сила в дБ, tn=1 — адаптивно)
MIC_LOWPASS=15000     # срезать высокочастотное шипение выше этой частоты, Гц
# ------------------------------------------------------------------------------

start_screencast(){
  touch /tmp/screencast && sleep 0.5s && refbar
  echo "$FILENAME" > /tmp/screencast

  # Параметры видео
  VIDEO_SIZE="$(xdpyinfo | awk '/dimensions/ {print $2;}')"

  # Источники звука — по умолчанию (см. также micplusspeakers.sh, здесь не нужен)
  local SINK MIC MIC_IS_MONITOR=0
  SINK="$(pactl get-default-sink)"
  MIC="$(pactl get-default-source)"
  case "$MIC" in *.monitor) MIC_IS_MONITOR=1 ;; esac

  # Аппаратное кодирование через VAAPI — разгружает ЦП. На этом ноутбуке это
  # Intel UHD 620 (Quick Sync), h264_vaapi проверен и работает; на других
  # машинах через тот же VAAPI пойдёт их GPU. Если VAAPI нет — libx264 на ЦП.
	if [ -e /dev/dri/renderD128 ] && ffmpeg -hide_banner -hwaccels 2>/dev/null | grep -qi vaapi; then
	  VIDEO_CODEC=(-vaapi_device /dev/dri/renderD128 \
	               -vf "format=nv12,hwupload" \
    	           -c:v h264_vaapi -qp 21 -bf 2 -g 60 -r 30)
	else
	  VIDEO_CODEC=(-c:v libx264 -crf 21 -preset veryfast -pix_fmt yuv420p -r 30)
	fi

  # Аудиовходы: [0]=видео, [1]=системный звук (monitor выхода), [2]=микрофон.
  # Микрофон чистим (highpass + шумодав + lowpass) и подмешиваем к системному.
  local AUDIO_INPUTS FILTER
  if [ "$MIC_IS_MONITOR" = 0 ]; then
    AUDIO_INPUTS=(-f pulse -thread_queue_size 4096 -i "${SINK}.monitor" \
                  -f pulse -thread_queue_size 4096 -i "$MIC")
    FILTER="[1:a]aresample=48000,volume=${SYS_VOL}[sys];\
[2:a]aresample=48000,highpass=f=${MIC_HIGHPASS},${MIC_DENOISE},lowpass=f=${MIC_LOWPASS},volume=${MIC_VOL}[mic];\
[sys][mic]amix=inputs=2:normalize=0:dropout_transition=0,\
aresample=async=1:first_pts=0,alimiter=limit=0.97[aout]"
  else
    # микрофона по умолчанию нет (источник — monitor): пишем только системный звук
    AUDIO_INPUTS=(-f pulse -thread_queue_size 4096 -i "${SINK}.monitor")
    FILTER="[1:a]aresample=48000,aresample=async=1:first_pts=0[aout]"
  fi

  PULSE_LATENCY_MSEC=60 ffmpeg -y \
    -f x11grab -thread_queue_size 4096 -framerate 30 -s "$VIDEO_SIZE" -i "$DISPLAY" \
    "${AUDIO_INPUTS[@]}" \
    "${VIDEO_CODEC[@]}" \
    -filter_complex "$FILTER" \
    -map 0:v:0 -map "[aout]" \
    -c:a aac -b:a 160k -ar 48000 -ac 2 \
    -movflags +faststart \
    "$FILENAME" &

  echo $! > /tmp/recordingpid
}

stop_screencast(){
  # Сначала корректно останавливаем ffmpeg, потом уже чистим звук: если убрать
  # loopback/recording раньше, ffmpeg на мгновение читает исчезнувший источник.
  recpid="$(cat /tmp/recordingpid 2>/dev/null || true)"
  rm -f /tmp/recordingpid

  if [ -n "$recpid" ] && kill -0 "$recpid" 2>/dev/null; then
    echo "🛑 Останавливаем запись (SIGTERM), ждём финализацию файла..."
    kill -15 "$recpid" || true
    # SIGTERM заставляет ffmpeg дописать файл: с +faststart он переносит moov
    # в начало, перечитывая весь файл. На длинной записи это дольше пары секунд,
    # поэтому ЖДЁМ фактического выхода, а не фиксированные 3 секунды. kill -9 —
    # только если процесс завис (не вышел за grace), иначе он рвёт файл на
    # середине финализации и запись не открывается.
    grace=60
    for i in $(seq 1 $((grace * 10))); do
      kill -0 "$recpid" 2>/dev/null || break
      sleep 0.1
    done
    if kill -0 "$recpid" 2>/dev/null; then
      echo "⚠️ ffmpeg не завершился за ${grace} с — принудительно (файл может быть повреждён)." >&2
      kill -9 "$recpid" 2>/dev/null || true
    else
      echo "✅ Файл дописан."
    fi
  fi

  echo "🧹 Выгружаем loopback и виртуальные устройства (PipeWire/PulseAudio)..."
  modules=$(pactl list short modules | grep -E 'module-loopback|module-null-sink|module-combine-sink' | cut -f1)
  if [ -z "$modules" ]; then
    echo "✅ Нет активных модулей для выгрузки."
  else
    for id in $modules; do
      pactl unload-module "$id" && echo "🧹 Выгружен модуль ID $id"
    done
    echo "✅ Очистка завершена."
  fi

  rm -f /tmp/screencast && refbar
  exit
}

loop_refresh(){
  while [ -f /tmp/screencast ]; do
    sleep 2
    refbar
  done
}

[ -f /tmp/screencast ] && stop_screencast
start_screencast && loop_refresh

