#!/bin/bash

start_webcam(){
	touch /tmp/webcam && sleep 0.5s && refbar
	# Камера (Integrated Camera, T480s) умеет 1280x720@30, но ТОЛЬКО в MJPG —
	# в несжатом YUYV на 720p всего 10 fps. Поэтому явно просим input_format=mjpeg.
	# Раньше стояло 640x480 (да ещё несжатый YUYV) — отсюда низкое качество.
	# --autofit держит окно умеренным (сам кадр всё равно 720p, downscale = чётче,
	# чем нативные 480). Убери --autofit, чтобы окно было в полный размер 720p.
	mpv --demuxer-lavf-o=video_size=1280x720,input_format=mjpeg,framerate=30 \
	    av://v4l2:/dev/video0 --profile=low-latency --untimed --title=webcam \
	    --no-cache --no-osc --no-input-default-bindings --autofit=960x540 -vf hflip
}


stop_webcam(){
	rm -f /tmp/webcam && refbar
	pkill -2 mpv
}



stop_webcam || start_webcam


