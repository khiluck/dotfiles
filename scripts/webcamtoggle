#!/bin/bash
#
# Окошко-оверлей с камерой (Win+q).
#
# Источник выбирается сам: если фоновый facecam запущен и отдаёт поток, берём
# его (в кадре 3D-модель вместо головы), иначе обычную камеру. Сам facecam этот
# скрипт НЕ трогает — он живёт отдельно, включается по Win+Shift+q
# (facecamtoggle) и переживает закрытие окошка.

VCAM=/dev/video10

# Признак того, что facecam отдаёт поток. Точный: при exclusive_caps=1
# устройство объявляет себя Video Output, пока в него никто не пишет, и
# переключается на Video Capture, когда поток пошёл. Проверяем состояние
# устройства, а не файл-флаг: флаг может остаться от упавшего процесса.
vcam_ready(){
	v4l2-ctl -d "$VCAM" --all 2>/dev/null \
		| grep -A2 "Device Caps" | grep -q "Video Capture"
}

# отступ окна камеры от краёв экрана, px (как у блогеров — не впритык)
MARGIN=28
# размер окошка камеры (кадр 4:3; уменьшение НЕ мылит — мылит только увеличение)
CAMSIZE=400x300

# Ставит плавающее окно камеры в правый-нижний угол с отступом MARGIN.
# Запускается в фоне и ждёт появления окна (mpv стартует не мгновенно).
# Полагаемся на xdotool, а не на mpv --geometry: dwm иначе может перехватить
# позицию при маппинге. Правило в config.h делает окно (instance=floatcam)
# плавающим — без него dwm бы его тайлил.
position_cam(){
	local wid i SW SH
	for i in $(seq 1 100); do
		wid=$(xdotool search --classname '^floatcam$' 2>/dev/null | head -1)
		[ -n "$wid" ] && break
		sleep 0.1
	done
	[ -n "$wid" ] || return
	sleep 0.2   # дать окну получить итоговый размер
	SW=$(xdotool getdisplaygeometry | cut -d' ' -f1)
	SH=$(xdotool getdisplaygeometry | cut -d' ' -f2)
	local WINDOW X Y WIDTH HEIGHT SCREEN
	eval "$(xdotool getwindowgeometry --shell "$wid")"
	xdotool windowmove "$wid" "$((SW - WIDTH - MARGIN))" "$((SH - HEIGHT - MARGIN))"
}

start_webcam(){
	touch /tmp/webcam && sleep 0.5s && refbar

	# Сенсор этой камеры (Integrated Camera, T480s) реально «видит» ~480p:
	# замеры резкости падают с ростом разрешения (640x480=104, 720p=46), то есть
	# 720p/960p — интерполяция без реальной детализации, да ещё и мягче. Поэтому
	# снимаем НАТИВНЫЕ 640x480 в несжатом YUYV (mpv берёт его по умолчанию — он
	# чётче MJPG на том же разрешении).
	#
	# Чёткость и «объём» поднимаем в самой камере (ISP): sharpness и contrast по
	# умолчанию стоят низко (0 и 32) — отсюда «замыленность». Это даёт больше,
	# чем любое повышение разрешения. power_line_frequency уже 50 Гц (без мерцания).
	v4l2-ctl -d /dev/video0 --set-ctrl=sharpness=5 --set-ctrl=contrast=48 2>/dev/null || true

	local src=/dev/video0
	local mirror=(-vf hflip)
	if vcam_ready; then
		src=$VCAM
		mirror=()   # facecam зеркалит сам, второй переворот вернул бы прямую картинку
	fi

	position_cam &

	# --x11-name=floatcam — по нему правило dwm делает окно плавающим и его ловит
	# position_cam. --ontop — держать поверх других окон, как оверлей блогера.
	mpv --demuxer-lavf-o=video_size=640x480 "av://v4l2:$src" \
	    --profile=low-latency --untimed --title=webcam --x11-name=floatcam --ontop \
	    --autofit="$CAMSIZE" \
	    --no-cache --no-osc --no-input-default-bindings "${mirror[@]}"
}


stop_webcam(){
	rm -f /tmp/webcam && refbar
	# SIGTERM, а не SIGINT: если скрипт сам запущен в фоне неинтерактивного
	# шелла, его потомки наследуют SIGINT как игнорируемый и -2 до них не
	# доходит. facecam тут НЕ останавливаем — он живёт своей жизнью.
	pkill -TERM -x mpv
}


# Переключаем по флагу, а не по коду возврата pkill: иначе состояние зависело бы
# от того, нашёлся ли процесс, и могло разъехаться.
if [ -e /tmp/webcam ]; then
	stop_webcam
else
	start_webcam
fi


