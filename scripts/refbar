#!/bin/bash
#
# Будит dwm_status: тот спит до начала следующей минуты, и если убить его sleep,
# бар перерисуется сразу. Нужно, когда состояние меняется по хоткею (📸, 🎭).

# sed -n ...p печатает ТОЛЬКО при совпадении. Без этого, когда dwm_status в
# момент вызова не спит, на выход уходила вся строка pstree, и kill ругался
# "not a pid or valid job spec".
pid=$(pstree -lp | grep -- -dwm_status\([0-9] | sed -n "s/.*sleep(\([0-9]\+\)).*/\1/p")

[ -n "$pid" ] && kill "$pid"
exit 0
